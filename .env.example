# ============================================================
# GlassBox 环境变量样板(M0 步骤 1 产出;盘点信息更新于 2026-07-08)
# 硬约束:模型/搜索一律用个人 key,严禁公司网关凭证(PROJECT_PLAN §1)
# ============================================================

# ---------- 部署目标:服务器盘点(2026-07-08 用户确认) ----------
# OS:Ubuntu 24.04(4c8G)
# 网络:大陆 IP;出口网络问题用户自理(架构上仍偏好大陆可直达的服务端点)
# 域名:已 ICP 备案(网络服务类)
# [待补] SSH 访问方式(CI 部署用,最晚步骤 6 前给出;建议专用部署 key + 限权用户)
# 合规备忘:面向公众的生成式 AI 服务另有算法/大模型备案要求;
#   缓解:登录制 + 访客只看回放 + 小流量作品集定位;若被要求整改再评估港/新节点
# 本地开发机(已盘点):Windows 11 / i7-14700 / 32G RAM / Docker 29 + Compose v5
#   注意:混沌测试(SIGKILL 语义)以 CI 的 Linux 环境为准绳,Windows 本机只做冒烟

# ---------- 数据库(M0 步骤 4 起用) ----------
DATABASE_URL=postgres://glassbox:change-me@localhost:5432/glassbox

# ---------- 模型供应商(个人 key;最小闭环不需要,最晚 M2 前开通) ----------
# 决策(2026-07-08):不用公司网关(总纲 §1 硬约束)。
# 公司网关上的同款模型个人渠道全部可得(以各平台当日模型列表为准):
#   GLM-5.2      → 智谱开放平台个人版 open.bigmodel.cn
#   Qwen3.7      → 阿里云百炼个人版 bailian.aliyun.com
#   DeepSeek V4  → DeepSeek 官方 platform.deepseek.com(主力:decide/抽取/综合)
#   embedding/rerank → SiliconFlow(BGE-m3 / bge-reranker-v2-m3,M3 用)
# 验证器与综合用不同供应商的模型(总纲 §4),上面开任意两家即满足
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# ---------- 搜索(M2 工具阶段才接) ----------
# 决策(2026-07-08):博查为主(国内直连、人民币计费);
#   若开通智谱 key,其 web_search 工具 API 可作 failover;
#   正文抓取走自建管线 undici+readability+turndown(M4,总纲 §8);
#   公司网关 unifiedsearch 不可用于本项目(绑公司凭证)
SEARCH_PROVIDER=bocha        # bocha | zhipu | tavily
SEARCH_API_KEY=

# ---------- 认证(M0 后期:better-auth + GitHub OAuth) ----------
BETTER_AUTH_SECRET=          # openssl rand -base64 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- 成本护栏(M0 第一天就要有,PROJECT_PLAN §8) ----------
DAILY_BUDGET_CNY=20          # 每日全局硬顶;超限排队或降级最便宜模型
